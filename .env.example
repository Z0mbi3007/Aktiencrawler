# ==========================================
# Wikifolio Depot Tracker - Konfiguration
# ==========================================

# 1. Wikifolio Zugangsdaten (Kostenloser Account)
# Wikifolio erfordert einen Login, um die Depotpositionen und Trades abzurufen.
WIKIFOLIO_EMAIL=deine-email@beispiel.de
WIKIFOLIO_PASSWORD=dein-geheimes-passwort

# Wikifolio Details für "NoLimits" (wfnolimits)
WIKIFOLIO_ID=485772de-e808-4451-8a53-1fc0378d3b87
WIKIFOLIO_SYMBOL=wfnolimits

# 2. Telegram Benachrichtigungen (Push auf Smartphone / Desktop)
# Erstelle einen Bot bei @BotFather in Telegram und trage das Token hier ein.
# Deine Chat-ID erhältst du z.B. vom Bot @userinfobot oder per https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789

# 3. Tracking-Einstellungen
# Überprüfungsintervall in Sekunden (z. B. 7200 = 2 Stunden)
CHECK_INTERVAL_SECONDS=7200

# Nur während der Börsenzeiten prüfen (Mo-Fr, 08:00 - 22:00 Uhr deutscher Zeit)
# Werte: true oder false (bei false wird 24/7 durchgehend geprüft)
MARKET_HOURS_ONLY=true

# 4. Optionale Benachrichtigung
# Desktop-Benachrichtigung direkt auf dem Mac anzeigen (Banner)
ENABLE_MACOS_NOTIFICATIONS=true
